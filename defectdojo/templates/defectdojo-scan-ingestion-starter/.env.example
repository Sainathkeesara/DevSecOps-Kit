# DefectDojo Scan Ingestion Starter - Environment Configuration
# Copy this file to .env and fill in the required values
# last_verified: 2026-10-23

# REQUIRED: Generate a strong password for PostgreSQL
# openssl rand -base64 32
DD_DATABASE_PASSWORD=changeme-strong-password

# REQUIRED: Generate a strong Django secret key
# openssl rand -base64 32
DD_SECRET_KEY=changeme-strong-secret-key

# Optional: Change the default admin password (default: admin)
DD_ADMIN_PASSWORD=admin

# Optional: Timezone for the container (default: UTC)
DD_TIME_ZONE=UTC

# Script environment variables (set these in your shell before running scripts)
# DEFECTDOJO_TOKEN=<your-api-token-from-ui>
# DEFECTDOJO_URL=http://localhost:8080
# PRODUCT_NAME=my-application
# ENGAGEMENT_NAME=ci-scan
# PRODUCT_TYPE=1
# ENGAGEMENT_DAYS=30